@baseUrl = http://localhost:8080/api/v1
# @baseUrl = http://schedule-visits.test/api/v1

### Schedule a visit -> 201
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "10:00"
}

### Same slot again -> 409
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Outro Cliente",
  "email": "outro@example.com",
  "phone": "11912345678",
  "date": "2026-09-10",
  "time": "10:00"
}

### Time outside business hours -> 409
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "23:00"
}

### Unknown vehicle -> 404
POST {{baseUrl}}/vehicles/9999/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "11:00"
}

### Non-numeric vehicle id -> 404 (rejected by the {id:\d+} route, never reaches the controller)
POST {{baseUrl}}/vehicles/abc/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "11:00"
}

### Missing required fields -> 400 with one message per field in "errors"
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{}

### Invalid email -> 400
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "not-an-email",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "11:00"
}

### Invalid phone -> 400
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "123",
  "date": "2026-09-10",
  "time": "11:00"
}

### Invalid date -> 400
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "10-09-2026",
  "time": "11:00"
}

### Invalid time -> 400
POST {{baseUrl}}/vehicles/1/appointments
Content-Type: application/json

{
  "name": "Gabriel Hamasaki",
  "email": "gabriel.hamasaki@exata.it",
  "phone": "11987654321",
  "date": "2026-09-10",
  "time": "25:99"
}
